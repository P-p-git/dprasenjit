# JWT Secret key for authentication (MUST be a long random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Session token lifetime (default 1d)
JWT_EXPIRES_IN=1d

# Initial admin account (used ONLY when the database is seeded/empty).
# NEVER commit real values. In production, always set ADMIN_PASSWORD.
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@tms.com
# ADMIN_PASSWORD=change_me_before_first_run
# If ADMIN_PASSWORD is unset, a strong random password is generated and printed once in the server logs.

# Comma-separated list of allowed browser origins (CORS allowlist).
# On Render set this to your frontend URL, e.g. https://your-app.onrender.com
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Public base URL used by the password-reset CLI when building reset links
APP_URL=http://localhost:3000

# Server port (Render injects this automatically)
PORT=5000

# Environment: development | production
NODE_ENV=development

# Optional: custom directory for the SQLite database file.
# REQUIRED on Render with a persistent disk so data survives deploys/restarts,
# e.g. DATA_DIR=/data where /data is the mounted disk path.
# DATA_DIR=/var/data

# PRODUCTION EMAIL DELIVERY (password reset):
# The backend stores single-use hashed reset tokens but does NOT send emails yet.
# Before production, wire an email provider into controllers/passwordResetController.js
# (see the marked hook) and set SMTP_CONFIGURED=true once delivery works.
# Until then, admins can mint one-time links with:
#   node utils/resetPasswordCli.js <username-or-email>
SMTP_CONFIGURED=false
